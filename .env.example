# ScamShield Environment Configuration
# Backend FastAPI API Base URL:
# For local development with Vite proxy: leave empty or set http://localhost:8000
# For direct connection or production deployment: set to your deployed FastAPI backend URL
VITE_API_URL=http://localhost:8000

# Set to 'false' to connect to live FastAPI backend (DEFAULT / PRODUCTION)
# Set to 'true' only to use offline mock data for demo testing
VITE_USE_MOCK_API=false

# Optional Backend OCR Configuration (set in backend environment):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
